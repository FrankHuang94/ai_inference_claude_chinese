# ============================================================
# InferenceAtlas .gitignore
# 红线：模型权重、大型数据集、二进制文件、密钥一律不得入库
# ============================================================

# --- 模型权重与大型模型产物 ---
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.gguf
*.ggml
*.onnx
*.engine
*.plan
*.trt
*.tflite
*.mlmodel
*.mlpackage/
*.pb
*.h5
*.npz
*.npy

# --- 大型数据集与压缩包 ---
*.parquet
*.arrow
*.feather
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
datasets/
checkpoints/
weights/
models/

# --- 密钥与凭据（绝对禁止入库）---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
*_token
*_secret
.netrc
.aws/
.ssh/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
env/
ENV/
.tox/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- QA 报告产物 ---
# reports/ 目录保留，但生成的报告不入库（每次可重新生成）
reports/*.md
!reports/.gitkeep

# --- 编辑器与操作系统 ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
.\#*
\#*\#

# --- 临时与缓存 ---
tmp/
temp/
.cache/
*.log
*.tmp
*.bak
*.orig
